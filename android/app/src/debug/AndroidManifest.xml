<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: allow plain http so the app can reach the backend on
     localhost or the home network during testing. Release builds keep
     Android's default and accept https only. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:usesCleartextTraffic="true" />
</manifest>
